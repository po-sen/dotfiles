#!/usr/bin/env bash
# Retired notification hooks. Keep these paths for existing local registrations.
# Do not read hook input, write logs, play sounds, or display notifications.
set -euo pipefail

case "${1:-}" in
    --native-handler|--session-start-hook|--stop-hook|--permission-request-hook)
        exit 0
        ;;
esac

# Preserve the old CLI wrapper for callers that still use it to launch Codex.
for candidate in \
    "${CODEX_NOTIFY_CODEX_BIN:-}" \
    /opt/homebrew/bin/codex \
    /usr/local/bin/codex \
    "$(command -v codex 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

printf 'codex-notify: unable to locate codex binary\n' >&2
exit 1
